# ---------------------------------------------------------------------------
# UNILORIN SpeakUp — environment template
# Copy to .env.local and fill in. NONE of this is required to run the landing
# page: `npm run dev` renders / with this file absent entirely.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Prisma against Supabase needs BOTH urls. Supabase Dashboard >
# Project Settings > Database > Connection string.
#
#   DATABASE_URL -> "Transaction pooler", port 6543, add ?pgbouncer=true
#   DIRECT_URL   -> "Direct connection",  port 5432
#
# Omitting DIRECT_URL is the usual reason `prisma migrate` fails on Supabase:
# migrations cannot run through the pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- NextAuth ---------------------------------------------------------------
# Generate: openssl rand -base64 32
# The socket server verifies session tokens with this SAME secret, so both
# processes must share it.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Socket.io --------------------------------------------------------------
# Socket.io needs a long-lived connection and cannot run on Netlify or Vercel —
# no serverless runtime keeps one open between requests. Locally this is
# `npm run socket`; in production point NEXT_PUBLIC_SOCKET_URL at the separate
# socket deployment (see render.yaml).
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
SOCKET_PORT=4000

# --- Supabase Storage (complaint attachments) -------------------------------
# The bucket must be PRIVATE. Complaint.files[] holds Storage object keys, not
# URLs; reads are authorized and signed for 60s by /api/attachments. A public
# bucket would hand out permanent unauthenticated links to students' evidence.
#
# SUPABASE_SERVICE_ROLE_KEY is server-side ONLY. Never rename it to
# NEXT_PUBLIC_* — that would ship full database bypass rights to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="complaint-files"

# --- Seed accounts ----------------------------------------------------------
# Used only by `npm run seed`. Change these before seeding anything real.
SEED_ADMIN_EMAIL="studentaffairs@unilorin.edu.ng"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_STUDENT_PASSWORD="Student123!"

# --- Email (Resend — password reset) ----------------------------------------
# Password-reset emails are sent through Resend. With RESEND_API_KEY absent
# the feature degrades cleanly: /auth/forgot-password answers 503 with a
# setup hint and the rest of the app is unaffected.
#
#   RESEND_API_KEY -> Resend Dashboard > API Keys
#   EMAIL_FROM     -> Must be a VERIFIED Resend domain/sender. Until
#                     unilorinstudentconnect.com is verified in Resend, the
#                     shared test sender below only delivers to the Resend
#                     account owner's own address.
#   APP_URL        -> Absolute base for links inside emails. Falls back to
#                     NEXTAUTH_URL when unset.
RESEND_API_KEY=""
EMAIL_FROM="UNILORIN Student Connect <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

#   RESET_EXEMPT_EMAILS -> Comma-separated addresses exempt from the 5-per-day
#                         password-reset cap (owner test accounts). Optional;
#                         unset falls back to the two built-in defaults.
RESET_EXEMPT_EMAILS="iyanuoluwaotaro@gmail.com,mutmainnahtope@gmail.com"
