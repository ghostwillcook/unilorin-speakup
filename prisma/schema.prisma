// UNILORIN SpeakUp — data model.
//
// User, Complaint, ChatMessage, Role and Status are the spec's models, ported
// as written. Setting is the admin-settings addition. ComplaintMessage carries
// per-complaint two-way threads; LiveConversation/LiveMessage is the single
// private student↔Unit channel ("Messages") — DirectMessage was folded into it
// by migration 20260829_merge_dm_livechat, when DMs and Live Chat turned out
// to be the same product twice. ChatMessage (the old global anonymous room)
// remains as the Chat Logs historical record. Notification and
// PushSubscription power the admin→student notification channel.

// (User relations note: the old dmThread/sentDms relations are gone with
// DirectMessage.)

generator client {
  provider = "prisma-client-js"
  // "native" is for local development. The second target is the engine that
  // runs on Netlify Functions and Render, both of which are Amazon Linux 2023
  // on Node 20; without it the deployed app fails at the first query with
  // "Query engine binary for current platform could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection for queries...
  url      = env("DATABASE_URL")
  // ...and a direct connection for migrations, which cannot run through
  // Supabase's pgbouncer pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  studentId         String            @unique
  passwordHash      String
  role              Role              @default(STUDENT)
  isActive          Boolean           @default(true)
  complaints        Complaint[]
  chatMessages      ChatMessage[]
  // Messages this user sent inside complaint threads.
  complaintMessages ComplaintMessage[] @relation("ComplaintMessages")
  // This user's private conversation with the Unit (the merged channel).
  liveConversation  LiveConversation?
  liveMessages      LiveMessage[]      @relation("LiveMessages")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([role])
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      Status   @default(PENDING)
  // Superseded by ComplaintMessage for new replies, but kept: existing rows
  // carry real history, and the field remains the single "outcome note" the
  // admin console can still set alongside the thread.
  adminReply  String?
  // Supabase Storage object keys, not URLs. The bucket is private; reads are
  // authorized and signed by /api/attachments.
  files       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ComplaintMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

/**
 * One message in a complaint's dedicated thread. The complaint is the parent
 * and context: messages can never cross complaints because every row hangs
 * off exactly one complaintId, and reads are always scoped by it.
 */
model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("ComplaintMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  Role
  content     String
  readAt      DateTime?
  /** Soft delete — see LiveMessage.deletedAt. */
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  // The real author. Persisted for the admin chat log and NEVER included in a
  // payload sent to a student client.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Per-session display name, e.g. "Anonymous #42".
  pseudonym String
  content   String
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([userId])
}

/**
 * Live Chat as the student's own support conversation with the Unit — one per
 * student (userId @unique), the merged private channel ("Messages") after
 * DirectMessage folded in. The conversation is the stable identity the inbox
 * hangs off: status, unread counts, and a pseudonym so the admin side can
 * show "Anonymous #42" without exposing the student's name.
 */
model LiveConversation {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pseudonym   String
  status      LiveStatus   @default(OPEN)
  // Denormalized unread counts so the inbox renders from one row, not one
  // aggregate query per conversation.
  adminUnread Int          @default(0)
  userUnread  Int          @default(0)
  messages    LiveMessage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, updatedAt])
}

model LiveMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   LiveConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation("LiveMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     Role
  content        String
  readAt         DateTime?
  /** Soft delete: set when the sender (or an admin) removes the message. The
   *  row stays for the audit trail; reads exclude it. */
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/** One in-app + Web Push notification per recipient. Broadcasts fan out to a
 *  row per student, so read state and delivery are per-user with no join
 *  tables; at demo scale that is the honest shape. */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/** A browser Web Push subscription (Web Push API), one row per device. A user
 *  may hold several; endpoints are globally unique per browser. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

enum Role {
  STUDENT
  ADMIN
}

enum Status {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum LiveStatus {
  OPEN
  WAITING
  CLOSED
}
